{
  "name": "dsh-ssh-workspace",
  "version": "0.1.0-local",
  "private": true,
  "type": "module",
  "description": "Switch a DeepSeek Harness session's workspace tools to an SSH host, like pi-ssh-remote",
  "license": "MIT",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "exports": {
    ".": "./index.js"
  },
  "dsh": {
